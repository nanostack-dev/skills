 "decisions": [
  {
   "id": "org-lock",
   "tag": "concurrency",
   "title": "A row lock keeps one pending invitation per email",
   "why": "Two concurrent creates queue on the lock, so only one passes the check.",
   "choice": "Every write takes `SELECT … FOR NO KEY UPDATE` on the organization first.",
   "instead": "A partial unique index, or SERIALIZABLE with retries.",
   "cost": "Invitation writes in one organization run one at a time.",
   "refs": [
    "path/to/service.go:100"
   ],
   "see": "race",
   "example": [
    {
     "label": "Two creates at the same instant",
     "lang": "http",
     "code": "POST /v1/products/prod_demo/organizations/org_acme/invitations\n{ \"email\": \"bob@example.invalid\", \"role_id\": \"role_member\" }\n\nrequest A → 201\nrequest B → 409\n{ \"errors\": [{ \"code\": \"ORGANIZATION_INVITATION_ALREADY_PENDING\" }] }"
    },
    {
     "label": "First statement of every write",
     "lang": "sql",
     "code": "SELECT * FROM organizations\nWHERE id = 'org_acme' FOR NO KEY UPDATE;  -- request B waits here"
    }
   ]
  }
 ],
