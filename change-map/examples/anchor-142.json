 },
 "flows": [
  {
   "name": "Create",
   "actor": "Product admin · `:create`",
   "tx": [
    2,
    7
   ],
   "steps": [
    {
     "k": "guard",
     "t": "Validate email, role and expiry",
     "err": "400 EXPIRY_NOT_IN_FUTURE"
    },
    {
     "k": "call",
     "t": "Generate the token and hash it"
    },
    {
     "k": "lock",
     "t": "Lock the organization row",
     "err": "404 organization"
    },
    {
     "k": "guard",
     "t": "Role exists in this Product",
     "err": "400 ROLE_NOT_FOUND_IN_REQUEST"
    },
    {
     "k": "guard",
     "t": "No pending invitation for the email",
     "err": "409 ALREADY_PENDING"
    },
    {
     "k": "guard",
     "t": "Email is not a member",
     "err": "409 EMAIL_IS_MEMBER"
    },
    {
     "k": "write",
     "t": "Insert the row with the hash"
    },
    {
     "k": "emit",
     "t": "`invitation.created`"
    }
   ],
   "result": "Returns the invitation and the clear token, once."
  },
  {
   "name": "Resend",
   "actor": "Product admin · `:update`",
   "tx": [
    1,
    4
   ],
   "steps": [
    {
     "k": "call",
     "t": "Generate a new token and hash it"
    },
    {
     "k": "lock",
     "t": "Lock the organization, find the invitation",
     "err": "404 NOT_FOUND"
    },
    {
     "k": "guard",
     "t": "Invitation is pending",
     "err": "409 ALREADY_ACCEPTED · EXPIRED"
    },
    {
     "k": "write",
     "t": "Replace the hash, expiry = now + 7 days"
    },
    {
     "k": "emit",
     "t": "`invitation.updated`"
    }
   ],
   "result": "The old token stops working. The new one is returned once."
  },
  {
   "name": "Accept",
   "actor": "Product, for a signed-in product user · `:update`",
   "tx": [
    1,
    6
   ],
   "steps": [
    {
     "k": "read",
     "t": "Hash the token, find the invitation",
     "err": "400 TOKEN_NOT_FOUND"
    },
    {
     "k": "lock",
     "t": "Lock the organization row"
    },
    {
     "k": "read",
     "t": "Read the invitation again under the lock"
    },
    {
     "k": "guard",
     "t": "Invitation is pending",
     "err": "409 ALREADY_ACCEPTED · EXPIRED"
    },
    {
     "k": "call",
     "t": "`AddMember` with the invited role",
     "err": "400 unknown user · 409 already a member"
    },
    {
     "k": "write",
     "t": "Set `accepted_at`"
    },
    {
     "k": "emit",
     "t": "`invitation.accepted` and `membership.created`"
    }
   ],
   "result": "All or nothing. A refused accept emits no event."
  },
  {
   "name": "Lookup",
   "actor": "Product, rendering its accept page · `:read`",
   "steps": [
    {
     "k": "read",
     "t": "Hash the token, find it in this Product",
     "err": "400 TOKEN_NOT_FOUND"
    },
    {
     "k": "call",
     "t": "Compute the status from the clock"
    }
   ],
   "result": "Returns the invitation without the token. It can read expired or accepted."
  }
 ],
