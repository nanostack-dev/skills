 "summary": "Adds organization invitations to Anchor. A Product invites an email address to an Organization with one role, gets back a one-time token, delivers it itself, and later accepts it for an existing product user, which creates the membership. Anchor stores only a hash of the token, works out the status when it reads, and emits four new product events.",
 "verdict": {
  "risk": "medium",
  "door": "two-way",
  "ask": "A new invitation resource: status is computed rather than stored, a row lock keeps one pending invitation per email, and the token alone is enough to join.",
  "doorNote": "Additive only: one new table, eight new routes, four new event types. Nothing that exists changes shape, and the down migration drops the table. It becomes one-way once a Product builds on the contract."
 },
 "decisions": [
  {
   "id": "status-derived",
   "tag": "schema",
   "title": "Status is computed on read, never stored",
   "choice": "No `status` column. Pending means `accepted_at` is null and `expires_at` is in the future. Expired is only ever computed.",
   "why": "Invitations expire when the clock passes, so there is no job flipping rows and no stale status to drift.",
   "instead": "A stored status plus a scheduled job that marks rows expired.",
   "cost": "\"One pending per email\" depends on `now()`, so it cannot be a partial unique index. The service has to enforce it.",
   "refs": [
    "apps/anchor/migrations/000039_organization_invitations.up.sql:7",
    "apps/anchor/internal/domain/organizationinvitation/invitation.go:37",
    "apps/anchor/internal/invitation/repository/repository.go:106"
   ]
  },
  {
   "id": "org-lock",
   "tag": "concurrency",
   "title": "An organization row lock keeps one pending invitation per email",
   "choice": "Every write first takes `SELECT … FOR NO KEY UPDATE` on the organization, then checks for a pending invitation and for a member with that email.",
   "why": "Two concurrent creates for the same email queue on the lock, so only one can pass the check. A CT runs the race.",
   "instead": "A partial unique index (impossible here) or SERIALIZABLE isolation with retries.",
   "cost": "All invitation writes in one organization run one at a time, and they wait on any other transaction holding that row.",
   "refs": [
    "apps/anchor/internal/invitation/service/service.go:100",
    "apps/anchor/internal/invitation/repository/repository.go:132",
    "apps/anchor/internal/invitation/service/service.go:405"
   ]
  },
  {
   "id": "token-hash",
   "tag": "security",
   "title": "Only a SHA-256 hash of the token is stored",
   "choice": "The `anchor_inv_…` token is returned once, by create and by resend. Lookup and accept hash what they receive and compare hashes.",
   "why": "A database leak does not hand out working invitations. It is the same pattern as API keys.",
   "instead": "Store the token so it can be shown again.",
   "cost": "A lost token cannot be recovered. The Product calls resend, which issues a new token and kills the old one.",
   "refs": [
    "apps/anchor/internal/security/security.go:96",
    "apps/anchor/migrations/000039_organization_invitations.up.sql:23",
    "apps/anchor/internal/invitation/service/service.go:351"
   ]
  },
  {
   "id": "no-email",
   "tag": "boundary",
   "title": "Anchor sends no email. The Product delivers the token.",
   "choice": "Anchor owns the invitation record and its lifecycle. Delivery, the email template and the accept page all belong to the Product.",
   "why": "Each Product has its own brand, sender and accept flow. ADR-0019 settles this.",
   "instead": "Anchor emails the invitee.",
   "cost": "Every Product has to build its own email and its own accept page.",
   "refs": [
    "apps/anchor/internal/invitation/service/service.go:21"
   ]
  },
  {
   "id": "token-bearer",
   "tag": "security",
   "title": "Accept trusts the token, not the email address",
   "choice": "Accept takes a token and an existing product user. It does not compare the invited email with that user's email, and it never creates a product user.",
   "why": "The Product owns identity. Invitees often sign in with a different address (an alias or SSO).",
   "instead": "Refuse the accept when the emails differ.",
   "cost": "The token works like a password: whoever holds it can join with any product user of that Product.",
   "refs": [
    "apps/anchor/internal/invitation/service/service.go:285"
   ]
  },
  {
   "id": "token-body",
   "tag": "api",
   "title": "The token only travels in request bodies",
   "choice": "Lookup and accept are `POST /v1/products/{product_id}/invitations/{lookup,accept}` with the token in the body. An unknown token returns 400, not 404.",
   "why": "URLs end up in access logs, proxies and browser history. The 400 matches the existing rule for identifiers that arrive in a body.",
   "instead": "`GET /invitations/{token}`.",
   "cost": "A read done as a POST: responses cannot be cached, and it is not plain REST.",
   "refs": [
    "apps/anchor/cmd/http/openapi.yaml:6728",
    "apps/anchor/internal/api/organization_invitation_api.go:152"
   ]
  },
  {
   "id": "reuse-addmember",
   "tag": "logic",
   "title": "Accept reuses AddMember in the same transaction",
   "choice": "Accept calls the membership service's `AddMember`, marks the invitation accepted and emits both events inside one transaction.",
   "why": "Membership rules and the `organization.membership.created` event live in one place, so an invited member is exactly like a member added directly.",
   "instead": "Insert the membership row from the invitation service.",
   "cost": "The invitation package now depends on the core service package, and two error constructors there became exported.",
   "refs": [
    "apps/anchor/internal/invitation/service/service.go:318",
    "apps/anchor/internal/invitation/service/service.go:328"
   ]
  }
 ],
 "schema": {
  "hint": "One new table, migration 000039. No existing table changes.",
  "tables": [
   {
    "name": "organization_invitations",
    "new": true,
    "file": "apps/anchor/migrations/000039_organization_invitations.up.sql",
    "note": "An offer to join one organization, sent to one email address, with one role.",
    "cols": [
     [
      "id",
      "varchar(255)",
      "pk",
      "KSUID `oinv_…`"
     ],
     [
      "product_id",
      "varchar(255)",
      "fk → organizations (id, product_id)",
      "With `organization_id`, pins the row to its organization's Product"
     ],
     [
      "organization_id",
      "varchar(255)",
      "fk, cascade",
      "Deleting the organization deletes its invitations"
     ],
     [
      "email",
      "varchar(320)",
      "",
      "Stored as given, compared without case"
     ],
     [
      "product_role_id",
      "varchar(255)",
      "fk → product_roles, cascade",
      "The role granted on accept"
     ],
     [
      "token_hash",
      "varchar(255)",
      "unique",
      "SHA-256 of the token. The token itself is never stored."
     ],
     [
      "expires_at",
      "timestamptz",
      "",
      "Now + 7 days unless the caller sets it"
     ],
     [
      "accepted_at",
      "timestamptz",
      "null",
      "Set once, on accept. The only stored status signal."
     ],
     [
      "created_at · updated_at",
      "timestamptz",
      "",
      "`updated_at` maintained by trigger"
     ]
    ],
    "idx": [
     [
      "…_organization_id",
      "(organization_id)",
      "Search within an organization"
     ],
     [
      "…_organization_email",
      "(organization_id, LOWER(email))",
      "The one-pending-per-email check"
     ],
     [
      "…_product_role_id",
      "(product_role_id)",
      "The role delete cascade"
     ]
    ],
    "notes": [
     "No `status` column, no CHECK constraints, no business triggers.",
     "The composite foreign key stops an invitation from pointing at another Product's organization.",
     "The down migration drops the table."
    ]
   }
  ]
 },
