 "watch": [
  {
   "id": "delete-any",
   "sev": "question",
   "title": "Delete works on accepted and expired invitations",
   "body": "Delete has no status check. Deleting an accepted invitation removes its history and emits `organization.invitation.deleted` for something that is already a membership. Is that intended?",
   "ref": "apps/anchor/internal/invitation/service/service.go:205"
  },
  {
   "id": "resend-expiry",
   "sev": "question",
   "title": "Resend replaces a custom expiry with the 7-day default",
   "body": "Resend sets `expires_at` to now + 7 days. An expiry that was set on create or update is lost.",
   "ref": "apps/anchor/internal/invitation/service/service.go:226"
  },
  {
   "id": "role-cascade",
   "sev": "risk",
   "title": "Deleting a role deletes its invitations with no event",
   "body": "`product_role_id` cascades. A Product that mirrors invitations from events keeps entries that no longer exist. The PR notes this matches how memberships behave.",
   "ref": "apps/anchor/migrations/000039_organization_invitations.up.sql:22"
  },
  {
   "id": "endpoint-optin",
   "sev": "note",
   "title": "Existing event endpoints will not receive the new events",
   "body": "An endpoint stores an explicit list of event types. Each Product has to add the four invitation types to its endpoint config."
